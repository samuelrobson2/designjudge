{
  "name": "designjudge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Layout judge and local evaluation harness for AI-generated interfaces",
  "scripts": {
    "dj": "node --import tsx src/cli.ts",
    "collect": "node --import tsx src/cli.ts collect",
    "diagnose": "node --import tsx src/cli.ts diagnose",
    "judge": "node --import tsx src/cli.ts judge",
    "report": "node --import tsx src/cli.ts report",
    "mutate": "node --import tsx src/cli.ts mutate",
    "compare": "node --import tsx src/cli.ts compare",
    "view": "node --import tsx src/cli.ts view",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "sharp": "^0.34.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
